# Vercel 프로젝트 > Settings > Environment Variables 에 아래 값들을 등록하세요.
# 실제 값은 이 파일에 채우지 말고, Vercel 대시보드에만 입력하세요.

# 카카오 Developers > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# 카카오 Developers > 내 애플리케이션 > 앱 키 > JavaScript 키
# 내 주변 Pet 지도에서 현재 위치/업체 마커를 표시할 때 사용합니다.

# 카카오 Developers > 내 애플리케이션 > 카카오 로그인 > 보안 > Client Secret
KAKAO_CLIENT_SECRET=

# 세션(로그인 유지) 서명에 쓰는 임의의 긴 문자열. 터미널에서 아래 명령으로 생성할 수 있어요.
#   openssl rand -hex 32
SESSION_SECRET=

# (선택) 운영 도메인이 https://www.petgrow.co.kr 가 아니라면 지정하세요. 기본값 그대로면 비워두면 돼요.
PUBLIC_BASE_URL=

# Vercel Postgres(Storage 탭)를 이 프로젝트에 연결하면 아래 값들은 자동으로 채워져요. 직접 입력할 필요 없음.
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# Pet톡 게시글 사진 + Pet음악 음원/커버 + PetLife 사진 + 암호화 백업 저장용.
# Vercel 프로젝트 > Storage 탭에서 Blob 스토어를 만들어 연결하면 자동으로 채워집니다.
# BLOB_READ_WRITE_TOKEN=

# Pet톡 신고 이메일 / 관리자
RESEND_API_KEY=
REPORT_EMAIL_TO=help.petgrow@gmail.com
REPORT_EMAIL_FROM=PetGrow 신고 <report@your-verified-domain.com>
# 둘 중 하나만 설정하면 됩니다.
# PETGROW_ADMIN_USER_ID= (구버전 호환용, 새 PIN 관리자 방식에서는 사용하지 않음)
# PETGROW_ADMIN_KAKAO_ID= (구버전 호환용, 새 PIN 관리자 방식에서는 사용하지 않음)

PETGROW_ADMIN_SETUP_CODE=여기에_길고_추측하기_어려운_최초등록코드

# Analytics
# 별도 키 불필요: 익명 세션 해시에 기존 SESSION_SECRET을 사용합니다.

# PetLife 자동화 Cron 보호용. 설정하면 Vercel Cron이 Authorization: Bearer <CRON_SECRET>로 호출합니다.
CRON_SECRET=

# PetLife Android 원격 푸시(FCM HTTP v1)
# Firebase 서비스 계정 JSON의 project_id, client_email, private_key 값을 각각 등록합니다.
# private_key는 Vercel 환경변수에 줄바꿈을 \n 형태로 넣어도 서버에서 복원합니다.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# 중앙 DB 암호화 백업
# 최소 32자 이상의 무작위 값을 권장합니다. 이 키가 없으면 자동 백업은 안전하게 건너뜁니다.
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30

# Android AdMob
# PetGrow 앱 ID는 AndroidManifest.xml에 설정되어 있습니다.
# 배너 광고 단위는 환경변수를 지정하지 않으면 현재 PetGrow 배너 단위 기본값을 사용합니다.
VITE_ADMOB_BANNER_ID=ca-app-pub-9699974051273244/9809518314

# 공공데이터포털 내 주변 Pet (업종별 인증키)
PUBLIC_DATA_HOSPITAL_KEY=
PUBLIC_DATA_PHARMACY_KEY=
PUBLIC_DATA_GROOMING_KEY=
PUBLIC_DATA_BOARDING_KEY=
PUBLIC_DATA_SALES_KEY=

# Kakao Maps Web SDK (JavaScript key; register your production domain in Kakao Developers)
VITE_KAKAO_JAVASCRIPT_KEY=

# GitHub Actions Secrets (Vercel 환경변수가 아니라 GitHub 저장소 > Settings > Secrets and variables > Actions에 등록)
# GOOGLE_SERVICES_JSON_BASE64 : Firebase Android google-services.json 파일을 base64로 인코딩한 값
# ANDROID_KEYSTORE_BASE64 / ANDROID_KEYSTORE_PASSWORD / ANDROID_KEY_ALIAS / ANDROID_KEY_PASSWORD : Play 서명용
