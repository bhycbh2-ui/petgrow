<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:navigationBarColor">#FFFDF6</item>
        <item name="android:statusBarColor">#FFFDF6</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!--
        Android 12+ ignores a normal android:background for the system splash.
        Set the splash API attributes explicitly so the OS never falls back to
        a cached/default launcher graphic (the white box / multicolor mark).
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFDF6</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>

        <!-- Pre-Android-12 fallback. -->
        <item name="android:background">@drawable/petgrow_native_splash</item>
    </style>
</resources>
