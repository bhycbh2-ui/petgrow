<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFFDF6"
                android:centerColor="#F7F4E9"
                android:endColor="#EAF2E2" />
        </shape>
    </item>

    <item
        android:width="116dp"
        android:height="116dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:angle="315"
                android:startColor="#19A35A"
                android:centerColor="#08743F"
                android:endColor="#034B31" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>

    <item
        android:width="116dp"
        android:height="116dp"
        android:gravity="center"
        android:drawable="@drawable/petgrow_launcher_foreground" />
</layer-list>
